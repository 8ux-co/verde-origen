# Verde Origen: environment. Copy to .env.local for development; set the same
# names in the host (Vercel) for production. Never commit real values.

# A SECRET key of the Zap site (secret_…). Server reads, preview-token checks,
# codegen and the seed. Create it in Zap: Sitio → Claves de API.
EELZAP_API_KEY=

# Zap's delivery API base, before /v1. Production default: https://api.eelzap.com
# Local Zap: http://localhost:5047/api/public
EELZAP_BASE_URL=
# Optional: a different path prefix than /v1.
EELZAP_PATH_PREFIX=

# Where Zap's editor answers (preview-token checks). Default: https://zap.eel.software
# Local Zap: http://localhost:5047 (passed to <ZapPreview zapOrigin> as well).
EELZAP_ORIGIN=

# The Zap site: its key and id (Sitio → Ajustes). The id turns on Shift Z suggestions.
EELZAP_SITE_KEY=
EELZAP_SITE_ID=

# The webhook endpoint's signing secret (whsec_…), from Nest → Webhooks.
EELZAP_WEBHOOK_SECRET=

# Public origin of this site, for canonical URLs, the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=

# Optional: ISR window for published content, in seconds (default 3600).
EELZAP_REVALIDATE_SECONDS=
# Optional: media hosts allowed for image optimisation (default **.r2.dev,**.r2.cloudflarestorage.com).
EELZAP_MEDIA_HOSTS=

# Development only: a local Nest for the Shift Z sign-in (http://localhost:5044).
EELZAP_DEV_AUTH_ORIGIN=

# Seed only: folder with the 20 source photos (PNG). Default ./seed-photos
SEED_PHOTOS_DIR=
# Seed only: the Zap site's base URL (default NEXT_PUBLIC_SITE_URL) and extra origins (comma-separated).
SEED_SITE_URL=
SEED_PREVIEW_ORIGINS=

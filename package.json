{
  "name": "verde-origen",
  "version": "0.1.0",
  "private": true,
  "description": "Verde Origen, specialty coffee roasters in Bogotá: the brand site and the reference integration for Eel Zap.",
  "license": "MIT",
  "author": "EelZap",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev -p 5070",
    "dev:https": "next dev -p 5070 --experimental-https --experimental-https-key certificates/localhost-key.pem --experimental-https-cert certificates/localhost.pem",
    "build": "next build",
    "start": "next start -p 5070",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "cms:types": "node --env-file-if-exists=.env.local node_modules/@8ux-co/eelzap-cli/dist/cli.js codegen && prettier --write src/generated/cms"
  },
  "dependencies": {
    "@8ux-co/eelzap": "^0.10.1",
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@8ux-co/eelzap-cli": "^0.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
